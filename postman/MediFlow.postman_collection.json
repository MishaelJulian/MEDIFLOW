{
  "info": {
    "_postman_id": "mediflow-api-v1-collection",
    "name": "MediFlow API v1 Collection",
    "description": "Comprehensive Postman collection for MediFlow Hospital Patient & Appointment Management System covering Authentication, Patients, Doctors, Departments, Availability, Appointments, Prescriptions, Medical History, Notifications, Billing, Admin Controls, and Analytics.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "doctorToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "patientToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "departmentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "doctorId",
      "value": "",
      "type": "string"
    },
    {
      "key": "appointmentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "invoiceId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00. Health & Discovery",
      "item": [
        {
          "name": "API Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "API Index / Directory",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            }
          }
        }
      ]
    },
    {
      "name": "01. Auth Module (M01)",
      "item": [
        {
          "name": "Register Patient",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane.doe@example.com\",\n  \"password\": \"Password@123\",\n  \"phone\": \"+15551234567\",\n  \"role\": \"PATIENT\",\n  \"gender\": \"FEMALE\",\n  \"dob\": \"1995-05-15\",\n  \"bloodGroup\": \"O+\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "    pm.collectionVariables.set('adminToken', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@mediflow.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login (Doctor)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "    pm.collectionVariables.set('doctorToken', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"doctor.sarah@mediflow.com\",\n  \"password\": \"Doctor@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login (Patient)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "    pm.collectionVariables.set('patientToken', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane.doe@example.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User Profile (/auth/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "02. Departments & Doctors (M02 & M03)",
      "item": [
        {
          "name": "List Departments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/departments",
              "host": ["{{baseUrl}}"],
              "path": ["departments"]
            }
          }
        },
        {
          "name": "Create Department (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cardiology\",\n  \"description\": \"Comprehensive cardiac care and heart health\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/departments",
              "host": ["{{baseUrl}}"],
              "path": ["departments"]
            }
          }
        },
        {
          "name": "Doctor Directory with Availability",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/directory/doctors",
              "host": ["{{baseUrl}}"],
              "path": ["directory", "doctors"]
            }
          }
        },
        {
          "name": "Set Doctor Availability",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-12-15\",\n  \"startTime\": \"09:00\",\n  \"endTime\": \"14:00\",\n  \"slotDuration\": 30\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/doctors/me/availability",
              "host": ["{{baseUrl}}"],
              "path": ["doctors", "me", "availability"]
            }
          }
        }
      ]
    },
    {
      "name": "03. Appointments (M04 & M05)",
      "item": [
        {
          "name": "Book Appointment (Patient)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"{{doctorId}}\",\n  \"date\": \"2026-12-15\",\n  \"startTime\": \"10:00\",\n  \"endTime\": \"10:30\",\n  \"reason\": \"Routine checkup and consultation\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/appointments",
              "host": ["{{baseUrl}}"],
              "path": ["appointments"]
            }
          }
        },
        {
          "name": "List Appointments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/appointments",
              "host": ["{{baseUrl}}"],
              "path": ["appointments"]
            }
          }
        },
        {
          "name": "Confirm Appointment (Staff/Doctor)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{doctorToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/appointments/{{appointmentId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["appointments", "{{appointmentId}}", "confirm"]
            }
          }
        },
        {
          "name": "Complete Appointment (Doctor)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clinicalNotes\": \"Patient diagnosed with mild fatigue. Prescribed vitamin supplements and advised hydration.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/appointments/{{appointmentId}}/complete",
              "host": ["{{baseUrl}}"],
              "path": ["appointments", "{{appointmentId}}", "complete"]
            }
          }
        },
        {
          "name": "Cancel Appointment",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Schedule conflict\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/appointments/{{appointmentId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["appointments", "{{appointmentId}}", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "04. Prescriptions & Medical History (M06 & M07)",
      "item": [
        {
          "name": "Create Prescription (Doctor)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointmentId\": \"{{appointmentId}}\",\n  \"diagnosis\": \"Mild Acute Rhinitis\",\n  \"medications\": [\n    {\n      \"name\": \"Cetirizine 10mg\",\n      \"dosage\": \"1 tablet\",\n      \"frequency\": \"Once daily at bedtime\",\n      \"duration\": \"5 days\",\n      \"instructions\": \"Take with water after food\"\n    }\n  ],\n  \"advice\": \"Drink plenty of warm fluids and rest.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/prescriptions",
              "host": ["{{baseUrl}}"],
              "path": ["prescriptions"]
            }
          }
        },
        {
          "name": "Get My Medical History (Patient)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/medical-history/me",
              "host": ["{{baseUrl}}"],
              "path": ["medical-history", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "05. Notifications (M09)",
      "item": [
        {
          "name": "List My Notifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/notifications",
              "host": ["{{baseUrl}}"],
              "path": ["notifications"]
            }
          }
        },
        {
          "name": "Unread Notification Count",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/notifications/unread-count",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", "unread-count"]
            }
          }
        },
        {
          "name": "Mark All Notifications Read",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/notifications/mark-all-read",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", "mark-all-read"]
            }
          }
        }
      ]
    },
    {
      "name": "06. Billing & Invoices (M10)",
      "item": [
        {
          "name": "Create Invoice (Doctor / Staff / Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointmentId\": \"{{appointmentId}}\",\n  \"lineItems\": [\n    {\n      \"description\": \"Specialist Consultation\",\n      \"amount\": 150,\n      \"quantity\": 1\n    },\n    {\n      \"description\": \"Routine CBC Diagnostic\",\n      \"amount\": 50,\n      \"quantity\": 1\n    }\n  ],\n  \"tax\": 10,\n  \"discount\": 0,\n  \"notes\": \"Follow-up consultation after 14 days\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/billing",
              "host": ["{{baseUrl}}"],
              "path": ["billing"]
            }
          }
        },
        {
          "name": "Get My Invoices (Patient)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/billing/my-invoices",
              "host": ["{{baseUrl}}"],
              "path": ["billing", "my-invoices"]
            }
          }
        },
        {
          "name": "Get Single Invoice Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/billing/{{invoiceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["billing", "{{invoiceId}}"]
            }
          }
        },
        {
          "name": "Pay Invoice (Simulated Payment)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"UPI\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/billing/{{invoiceId}}/pay",
              "host": ["{{baseUrl}}"],
              "path": ["billing", "{{invoiceId}}", "pay"]
            }
          }
        },
        {
          "name": "Admin: Query All Invoices",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/billing",
              "host": ["{{baseUrl}}"],
              "path": ["billing"]
            }
          }
        }
      ]
    },
    {
      "name": "07. Admin Controls (M12)",
      "item": [
        {
          "name": "List All Users (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"]
            }
          }
        },
        {
          "name": "Update User Active Status (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/users/{{userId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users", "{{userId}}", "status"]
            }
          }
        },
        {
          "name": "Overview Clinic Appointments (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/appointments",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "appointments"]
            }
          }
        }
      ]
    },
    {
      "name": "08. Reports & Dashboards (M13 & M15)",
      "item": [
        {
          "name": "Hospital Summary / Admin Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/analytics/admin-dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "admin-dashboard"]
            }
          }
        },
        {
          "name": "Operational Reports (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/analytics/reports",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "reports"]
            }
          }
        },
        {
          "name": "Doctor Dashboard Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{doctorToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/analytics/doctor-dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "doctor-dashboard"]
            }
          }
        },
        {
          "name": "Patient Dashboard Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/analytics/patient-dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "patient-dashboard"]
            }
          }
        },
        {
          "name": "AI No-Show Risk Assessment",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{doctorToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/analytics/no-show-risk/{{appointmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "no-show-risk", "{{appointmentId}}"]
            }
          }
        }
      ]
    }
  ]
}
